#!/bin/sh
set -eu

state_dir=/var/lib/sddm
state_file="${state_dir}/state.conf"

if [ -e "${state_file}" ]; then
    exit 0
fi

install -d -m 0755 "${state_dir}"
cat >"${state_file}" <<'EOF'
[Last]
Session=lxqt-labwc.desktop
EOF
chown sddm:sddm "${state_file}" 2>/dev/null || true
chmod 0644 "${state_file}"
